#usda 1.0
(
    defaultPrim = "pipette"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "pipette"
{
    def Xform "body" (
        prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI", "PhysxRigidBodyAPI", "PhysicsArticulationRootAPI"]
    )
    {
        float physics:mass = 0.085
        bool physics:rigidBodyEnabled = 1
        float physxRigidBody:maxDepenetrationVelocity = 0.2
        int physxRigidBody:solverPositionIterationCount = 32
        int physxRigidBody:solverVelocityIterationCount = 4

        def Cylinder "shape_1" (
            prepend apiSchemas = ["PhysicsCollisionAPI", "PhysxCollisionAPI"]
        )
        {
            uniform token axis = "Z"
            double height = 0.13
            float physxCollision:contactOffset = 0.0001
            float physxCollision:restOffset = 0
            color3f[] primvars:displayColor = [(0.83, 0.86, 0.88)]
            double radius = 0.011
            double3 xformOp:translate = (0, 0, 0.085)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }

        def Cylinder "shape_2" (
            prepend apiSchemas = ["PhysicsCollisionAPI", "PhysxCollisionAPI"]
        )
        {
            uniform token axis = "Z"
            double height = 0.025
            float physxCollision:contactOffset = 0.0001
            float physxCollision:restOffset = 0
            color3f[] primvars:displayColor = [(0.18, 0.4, 0.6)]
            double radius = 0.003
            double3 xformOp:translate = (0, 0, 0.0125)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }

        def Cube "shape_3" (
            prepend apiSchemas = ["PhysicsCollisionAPI", "PhysxCollisionAPI"]
        )
        {
            float physxCollision:contactOffset = 0.0001
            float physxCollision:restOffset = 0
            color3f[] primvars:displayColor = [(0.18, 0.4, 0.6)]
            double size = 1
            float3 xformOp:scale = (0.016, 0.008, 0.06)
            double3 xformOp:translate = (0, 0.012, 0.08)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        }

        def Cylinder "shape_4" (
            prepend apiSchemas = ["PhysicsCollisionAPI", "PhysxCollisionAPI"]
        )
        {
            uniform token axis = "Z"
            double height = 0.006
            float physxCollision:contactOffset = 0.0001
            float physxCollision:restOffset = 0
            color3f[] primvars:displayColor = [(0.18, 0.4, 0.6)]
            double radius = 0.014
            double3 xformOp:translate = (0, 0, 0.025)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }
    }

    def Xform "plunger" (
        prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI", "PhysxRigidBodyAPI"]
    )
    {
        float physics:mass = 0.005
        bool physics:rigidBodyEnabled = 1
        float physxRigidBody:maxDepenetrationVelocity = 0.2
        int physxRigidBody:solverPositionIterationCount = 32
        int physxRigidBody:solverVelocityIterationCount = 4
        double3 xformOp:translate = (0, 0, 0.155)
        uniform token[] xformOpOrder = ["xformOp:translate"]

        def Cylinder "shape_5" (
            prepend apiSchemas = ["PhysicsCollisionAPI", "PhysxCollisionAPI"]
        )
        {
            uniform token axis = "Z"
            double height = 0.01
            float physxCollision:contactOffset = 0.0001
            float physxCollision:restOffset = 0
            color3f[] primvars:displayColor = [(0.18, 0.4, 0.6)]
            double radius = 0.006
            double3 xformOp:translate = (0, 0, 0.005)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }

        def Cylinder "shape_6" (
            prepend apiSchemas = ["PhysicsCollisionAPI", "PhysxCollisionAPI"]
        )
        {
            uniform token axis = "Z"
            double height = 0.012
            float physxCollision:contactOffset = 0.0001
            float physxCollision:restOffset = 0
            color3f[] primvars:displayColor = [(0.53, 0.56, 0.6)]
            double radius = 0.003
            double3 xformOp:translate = (0, 0, -0.004)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }
    }

    def PhysicsPrismaticJoint "plunger_joint" (
        prepend apiSchemas = ["PhysicsDriveAPI:linear"]
    )
    {
        float drive:linear:physics:damping = 2
        float drive:linear:physics:maxForce = 3
        float drive:linear:physics:stiffness = 160
        float drive:linear:physics:targetPosition = 0
        uniform token drive:linear:physics:type = "force"
        uniform token physics:axis = "Z"
        rel physics:body0 = </pipette/body>
        rel physics:body1 = </pipette/plunger>
        point3f physics:localPos0 = (0, 0, 0.155)
        float physics:lowerLimit = -0.008
        float physics:upperLimit = 0
    }
}

